{% extends 'base.html.twig' %}

{% block title %}Authors - Community Library{% endblock %}

{% block body %}
    <h1>Our collection ({{ authors|length }} authors)</h1>

    <div class="book-grid">
        {% for author in authors %}
            <div class="book-card">
                <h2>
                    <a href="{{ path('app_author_show', {id: author.id}) }}">
                        {{ author.name }}
                    </a>
                </h2>
                <p>{{ author.books|length }} books</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}
